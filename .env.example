# ── LLM provider (anthropic | openai | google | groq) ─────────────
# All keys below are OPTIONAL if users bring their own via the console's
# KEYS vault (BYOK): keys then arrive per-request and are never stored.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Optional per-role model overrides (else sensible defaults per provider)
NERO_PLANNER_MODEL=
NERO_EXECUTOR_MODEL=
NERO_CRITIC_MODEL=

# ── BLUE ROSE web search (optional; fetch works without it) ───────
TAVILY_API_KEY=

# ── TRISH memory (optional; falls back to in-memory for dev) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis URL for mcp-handler Streamable HTTP session resumption
REDIS_URL=

# ── Guardrails ─────────────────────────────────────────────────────
NERO_TOKEN_BUDGET=150000
NERO_MAX_REFLECTIONS=2

# ── YAMATO transport: "local" (in-process tools) | "remote" (MCP over HTTP)
YAMATO_MODE=local
# Base URL of this deployment, used when YAMATO_MODE=remote
NERO_SELF_URL=
